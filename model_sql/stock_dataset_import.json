{
  "dataSetConfig": {
    "name": "股票数据分析",
    "bizName": "StockAnalysis",
    "description": "包含股票日线数据和基本信息的完整数据集，支持多维度分析",
    "includesAll": true,
    "metrics": [
      {
        "name": "最大涨幅",
        "bizName": "max_gain",
        "expr": "MAX(涨跌幅)",
        "description": "时间段内的最大涨跌幅"
      },
      {
        "name": "最小涨幅",
        "bizName": "min_gain",
        "expr": "MIN(涨跌幅)",
        "description": "时间段内的最小涨跌幅"
      },
      {
        "name": "平均涨跌幅",
        "bizName": "avg_change",
        "expr": "AVG(涨跌幅)",
        "description": "时间段内的平均涨跌幅"
      },
      {
        "name": "累计涨跌幅",
        "bizName": "total_change",
        "expr": "SUM(涨跌幅)",
        "description": "时间段内的累计涨跌幅"
      },
      {
        "name": "总成交量",
        "bizName": "total_volume",
        "expr": "SUM(成交量)",
        "description": "时间段内的总成交量"
      },
      {
        "name": "总成交额",
        "bizName": "total_amount",
        "expr": "SUM(成交额)",
        "description": "时间段内的总成交额"
      },
      {
        "name": "平均换手率",
        "bizName": "avg_turnover_rate",
        "expr": "AVG(换手率)",
        "description": "时间段内的平均换手率"
      }
    ]
  },
  "models": [
    {
      "name": "股票日线数据",
      "bizName": "StockDailyData",
      "description": "股票每日交易数据（事实表）",
      "isPrimary": true,
      "dbSchema": {
        "db": "stocks_data",
        "table": "stock_zh_a_daily",
        "dbColumns": [
          {"columnName": "date", "dataType": "DATE", "comment": "交易日期"},
          {"columnName": "code", "dataType": "VARCHAR", "comment": "股票代码"},
          {"columnName": "open", "dataType": "DECIMAL", "comment": "开盘价"},
          {"columnName": "high", "dataType": "DECIMAL", "comment": "最高价"},
          {"columnName": "low", "dataType": "DECIMAL", "comment": "最低价"},
          {"columnName": "close", "dataType": "DECIMAL", "comment": "收盘价"},
          {"columnName": "change_pct", "dataType": "DECIMAL", "comment": "涨跌幅"},
          {"columnName": "change_amount", "dataType": "DECIMAL", "comment": "涨跌额"},
          {"columnName": "amplitude", "dataType": "DECIMAL", "comment": "振幅"},
          {"columnName": "volume", "dataType": "BIGINT", "comment": "成交量"},
          {"columnName": "amount", "dataType": "DECIMAL", "comment": "成交额"},
          {"columnName": "turnover_rate", "dataType": "DECIMAL", "comment": "换手率"}
        ]
      },
      "fields": [
        {"columnName": "date", "dataType": "DATE", "fieldType": "data_time", "name": "交易日期", "dateFormat": "yyyy-MM-dd", "timeGranularity": "day"},
        {"columnName": "code", "dataType": "VARCHAR", "fieldType": "primary_key", "name": "股票代码"},
        {"columnName": "open", "dataType": "DECIMAL", "fieldType": "measure", "name": "开盘价", "agg": ""},
        {"columnName": "high", "dataType": "DECIMAL", "fieldType": "measure", "name": "最高价", "agg": ""},
        {"columnName": "low", "dataType": "DECIMAL", "fieldType": "measure", "name": "最低价", "agg": ""},
        {"columnName": "close", "dataType": "DECIMAL", "fieldType": "measure", "name": "收盘价", "agg": ""},
        {"columnName": "change_pct", "dataType": "DECIMAL", "fieldType": "measure", "name": "涨跌幅", "agg": ""},
        {"columnName": "change_amount", "dataType": "DECIMAL", "fieldType": "measure", "name": "涨跌额", "agg": ""},
        {"columnName": "amplitude", "dataType": "DECIMAL", "fieldType": "measure", "name": "振幅", "agg": ""},
        {"columnName": "volume", "dataType": "BIGINT", "fieldType": "measure", "name": "成交量", "agg": ""},
        {"columnName": "amount", "dataType": "DECIMAL", "fieldType": "measure", "name": "成交额", "agg": ""},
        {"columnName": "turnover_rate", "dataType": "DECIMAL", "fieldType": "measure", "name": "换手率", "agg": ""}
      ]
    },
    {
      "name": "股票基本信息",
      "bizName": "StockInfo",
      "description": "股票基本信息（维度表）",
      "isPrimary": false,
      "joinCondition": "股票代码 = 股票代码",
      "dbSchema": {
        "db": "stocks_data",
        "table": "stock_info",
        "dbColumns": [
          {"columnName": "code", "dataType": "VARCHAR", "comment": "股票代码"},
          {"columnName": "name", "dataType": "VARCHAR", "comment": "股票名称"},
          {"columnName": "industry", "dataType": "VARCHAR", "comment": "所属行业"},
          {"columnName": "market", "dataType": "VARCHAR", "comment": "市场"},
          {"columnName": "status", "dataType": "VARCHAR", "comment": "状态"}
        ]
      },
      "fields": [
        {"columnName": "code", "dataType": "VARCHAR", "fieldType": "foreign_key", "name": "股票代码"},
        {"columnName": "name", "dataType": "VARCHAR", "fieldType": "dimension", "name": "股票名称"},
        {"columnName": "industry", "dataType": "VARCHAR", "fieldType": "dimension", "name": "所属行业"},
        {"columnName": "market", "dataType": "VARCHAR", "fieldType": "dimension", "name": "市场"},
        {"columnName": "status", "dataType": "VARCHAR", "fieldType": "dimension", "name": "股票状态"}
      ]
    }
  ]
}

